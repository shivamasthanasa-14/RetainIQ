# Publication allowlist. Unknown root files stay local until deliberately reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/app.py
!/retainiq/
!/tests/
!/requirements.txt
!/pytest.ini
!/.env.example
!/.streamlit/
!/data/
!/knowledge_base/
!/CASE_STUDY.md
!/demo_receiver.py
!/launch.ps1
!/prepare_demo_results.py

/.streamlit/*
!/.streamlit/config.toml

/data/*
!/data/scenarios/
!/data/prepared_catalog.json
!/data/RetainIQ_Import_Template.xlsx
/data/scenarios/*
!/data/scenarios/routine.json
!/data/scenarios/backlog.json
!/data/scenarios/complex.json

# Shared exclusions; example configuration is intentionally public.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.env
**/.env.*
!/.env.example
**/secrets.toml
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.zip
**/*.exe
**/*.msi
**/*.tmp
**/*.bak
**/*~
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/.agents/
**/.codex/
