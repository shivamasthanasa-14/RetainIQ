# Set these in your shell before launch; no secrets are included.
RETAINIQ_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
RETAINIQ_MODEL=qwen3:4b
# Optional OpenAI-compatible hosted endpoint:
# RETAINIQ_PROVIDER=hosted
# RETAINIQ_API_URL=https://your-provider.example/v1/chat/completions
# RETAINIQ_API_KEY=
# RETAINIQ_MODEL=your-model
# RETAINIQ_DB=data/retainiq.db

# session (default): private reviewer workspace; local: persist workstation work
RETAINIQ_WORKSPACE_MODE=session
# Optional data/workspace root; code and knowledge remain in the project
# RETAINIQ_WORKSPACE_ROOT=C:/path/to/retainiq-data
